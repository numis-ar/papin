#!/usr/bin/env python3
"""Rootfs-internal `papin-acp` shim.

Execs `kimi acp` (the real agent) with stdio bridged, and enforces the
stdin-EOF-exit assumption (PLAN §10 risk): if `kimi acp` does not exit on its
own within a grace period after stdin EOF, the child is killed. On hosts where
`kimi acp` exits cleanly on EOF this kill path never fires (M4 verification).
"""

import os
import signal
import subprocess
import sys
import threading

CHILD = ["kimi", "acp"]
EOF_GRACE_SECONDS = 5


def main():
    child = subprocess.Popen(
        CHILD,
        stdin=subprocess.PIPE,
        stdout=sys.stdout.buffer,
        stderr=sys.stderr.buffer,
    )

    def pump_stdin():
        try:
            while True:
                data = os.read(0, 65536)
                if not data:
                    break
                child.stdin.write(data)
                child.stdin.flush()
        except OSError:
            pass
        try:
            child.stdin.close()
        except OSError:
            pass
        # stdin EOF is the clean-exit signal for the systemd unit; if the
        # child is still alive after the grace period, kill it.
        try:
            child.wait(timeout=EOF_GRACE_SECONDS)
        except subprocess.TimeoutExpired:
            child.terminate()
            try:
                child.wait(timeout=5)
            except subprocess.TimeoutExpired:
                child.kill()

    threading.Thread(target=pump_stdin, daemon=True).start()
    rc = child.wait()
    sys.exit(rc)


if __name__ == "__main__":
    main()
